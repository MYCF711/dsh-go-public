  {
    "name": "schedule_create",
    "description": "登记定时任务（every/daily/weekly），算出下次触发时间。",
    "parameters": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "一句话名字，最多 120 字"
        },
        "prompt": {
          "type": "string",
          "description": "到点时要交给模型的话（祈使句）"
        },
        "kind": {
          "type": "string",
          "enum": [
            "every",
            "daily",
            "weekly"
          ],
          "description": "调度方式：every=每 N 秒；daily=每天某时刻；weekly=每周若干天的某时刻"
        },
        "every_seconds": {
          "type": "integer",
          "description": "kind=every 时必填，\u003e= 60"
        },
        "allow_writes": {
          "type": "boolean",
          "description": "默认 false：到点只跑只读工具。设 true 才会在无人值守时执行写操作，用户要清楚后果"
        },
        "daily_at": {
          "type": "string",
          "description": "kind=daily 时必填，本地时区 HH:MM，如 09:30"
        },
        "weekly_at": {
          "type": "string",
          "description": "kind=weekly 时必填，本地时区 HH:MM，如 09:30"
        },
        "weekdays": {
          "type": "array",
          "items": {
            "type": "integer"
          },
